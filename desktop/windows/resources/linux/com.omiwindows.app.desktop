# Reference desktop entry for portal identity / docs.
# Packaged builds generate the installed .desktop from electron-builder.config.mjs
# (`linux.desktop.entry` + syncDesktopName) — keep these fields in sync.
[Desktop Entry]
Type=Application
Name=Omi
GenericName=AI Assistant
Comment=AI that sees your screen, listens, and remembers
Exec=omi-windows %U
Icon=omi-windows
Terminal=false
Categories=Utility;
StartupWMClass=omi-windows
MimeType=x-scheme-handler/omi;
