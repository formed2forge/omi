<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained PublishSingleFile (the OCR / audio / UI-automation helpers)
  restores Microsoft.NET.ILLink.Tasks and the win-x64 runtime packs from NuGet.
  A fresh Windows SDK install often has *no* package sources (`dotnet nuget
  list source` → "No sources found"), which surfaces as NU1100 on ILLink.Tasks.
  Keep nuget.org here so `pnpm install` / `pnpm run build:*-helper` work without
  a prior `dotnet nuget add source`.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
